# Copy this file to .env and fill in real values. Never commit .env.

# --- Core ---
NODE_ENV=production
PORT=4000
APP_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_value
JWT_EXPIRES_IN=8h
COOKIE_SECURE=true

# --- Initial admin seed (only used by `npm run seed:admin`, then ignored) ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace_with_a_strong_password

# --- Database ---
DATABASE_PATH=./data/portfolio.db

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8

# --- Contact form ---
CONTACT_RATE_LIMIT_PER_HOUR=5
# How many days to retain raw contact submissions before they should be purged
# (purge is a manual/admin action, not automatic, so you decide the real policy)
CONTACT_RETENTION_NOTE_DAYS=180
